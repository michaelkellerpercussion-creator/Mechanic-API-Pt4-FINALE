{
  "swagger": "2.0",
  "info": {
    "title": "Mechanic Shop API",
    "description": "RESTful API for managing customers, mechanics, service tickets, and inventory with JWT authentication, rate limiting, and caching.",
    "version": "1.0.0"
  },
  "host": "127.0.0.1:5000",
  "basePath": "/",
  "schemes": ["http"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your JWT token formatted as: Bearer <your_token>"
    }
  },
  "paths": {
    "/customers/": {
      "get": {
        "tags": ["Customers"],
        "summary": "Get paginated list of customers",
        "description": "Retrieves a paginated list of registered customers. Supports 'page' and 'per_page' query parameters for pagination control. Results are cached to enhance API performance.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1,
            "description": "Page number to retrieve"
          },
          {
            "name": "per_page",
            "in": "query",
            "type": "integer",
            "default": 10,
            "description": "Number of records per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated customer list successfully retrieved",
            "schema": { "$ref": "#/definitions/CustomerPaginatedResponse" }
          },
          "400": {
            "description": "Invalid pagination parameters provided",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      },
      "post": {
        "tags": ["Customers"],
        "summary": "Register a new customer",
        "description": "Creates a new customer account in the system. Hashes the raw password string before saving to database storage.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CustomerPayload" }
          }
        ],
        "responses": {
          "201": {
            "description": "Customer registered successfully",
            "schema": { "$ref": "#/definitions/CustomerResponse" }
          },
          "400": {
            "description": "Validation failure due to missing or invalid fields",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/customers/login": {
      "post": {
        "tags": ["Customers"],
        "summary": "Authenticate customer",
        "description": "Validates user email and password credentials against stored database hashes and returns an encoded JWT Bearer token upon authentication success.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/LoginPayload" }
          }
        ],
        "responses": {
          "200": {
            "description": "Authentication successful; JWT token returned",
            "schema": { "$ref": "#/definitions/LoginResponse" }
          },
          "400": {
            "description": "Malformed request body or missing login credentials",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "401": {
            "description": "Invalid email or password credentials",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/customers/my-tickets": {
      "get": {
        "tags": ["Customers"],
        "summary": "Get authenticated customer service tickets",
        "description": "Retrieves all service ticket history linked to the currently authenticated customer account extracted from the validated JWT Bearer token.",
        "security": [{ "Bearer": [] }],
        "responses": {
          "200": {
            "description": "List of service tickets associated with the logged-in customer",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/ServiceTicketResponse" }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/customers/{id}": {
      "put": {
        "tags": ["Customers"],
        "summary": "Update customer details",
        "description": "Updates profile details for a specific customer. Access is restricted so that authenticated customers can only modify their own profile record.",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the customer to update"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CustomerUpdatePayload" }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer profile updated successfully",
            "schema": { "$ref": "#/definitions/CustomerResponse" }
          },
          "400": {
            "description": "Invalid payload values supplied for update",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "401": {
            "description": "Missing or expired authorization token",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "403": {
            "description": "Forbidden: Requesting user is not authorized to edit this profile",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Customer record with specified ID not found",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      },
      "delete": {
        "tags": ["Customers"],
        "summary": "Delete customer account",
        "description": "Deletes the customer record matching the specified ID from the database system. Authenticated users are only allowed to delete their own account.",
        "security": [{ "Bearer": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the customer account to remove"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer account deleted successfully",
            "schema": { "$ref": "#/definitions/MessageResponse" }
          },
          "401": {
            "description": "Authentication token missing or invalid",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "403": {
            "description": "Forbidden: Cannot delete an account belonging to another user",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Specified customer ID does not exist",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/mechanics/": {
      "get": {
        "tags": ["Mechanics"],
        "summary": "Get all mechanics",
        "description": "Fetches a full directory listing of all mechanics employed at the shop, including contact info and salary details.",
        "responses": {
          "200": {
            "description": "List of mechanic records retrieved",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/MechanicResponse" }
            }
          }
        }
      },
      "post": {
        "tags": ["Mechanics"],
        "summary": "Create mechanic profile",
        "description": "Registers a new mechanic in the database with their full name, email address, phone number, and baseline salary rate.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/MechanicPayload" }
          }
        ],
        "responses": {
          "201": {
            "description": "Mechanic profile created",
            "schema": { "$ref": "#/definitions/MechanicResponse" }
          },
          "400": {
            "description": "Validation failed for mechanic payload data",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/mechanics/most-active": {
      "get": {
        "tags": ["Mechanics"],
        "summary": "Get most active mechanics",
        "description": "Calculates and returns a performance summary list of mechanics ranked by the total number of service tickets assigned to them.",
        "responses": {
          "200": {
            "description": "Active mechanics ranked by ticket completion workload",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/MostActiveMechanicResponse" }
            }
          }
        }
      }
    },
    "/mechanics/{id}": {
      "put": {
        "tags": ["Mechanics"],
        "summary": "Update mechanic details",
        "description": "Modifies information for an existing mechanic record identified by target mechanic ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of mechanic to modify"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/MechanicPayload" }
          }
        ],
        "responses": {
          "200": {
            "description": "Mechanic profile updated",
            "schema": { "$ref": "#/definitions/MechanicResponse" }
          },
          "400": {
            "description": "Invalid input schema supplied for mechanic update",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Mechanic record not found for the provided ID",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      },
      "delete": {
        "tags": ["Mechanics"],
        "summary": "Delete mechanic",
        "description": "Permanently deletes a mechanic entry from the database system by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of mechanic to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Mechanic deleted successfully",
            "schema": { "$ref": "#/definitions/MessageResponse" }
          },
          "404": {
            "description": "Mechanic ID not found",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/inventory/": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get all inventory items",
        "description": "Retrieves the complete catalog of spare parts and inventory components available for repair service tickets.",
        "responses": {
          "200": {
            "description": "List of inventory items returned",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/InventoryResponse" }
            }
          }
        }
      },
      "post": {
        "tags": ["Inventory"],
        "summary": "Create inventory part",
        "description": "Adds a new part or component into the shop's active stock inventory catalog.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/InventoryPayload" }
          }
        ],
        "responses": {
          "201": {
            "description": "Part entry successfully created",
            "schema": { "$ref": "#/definitions/InventoryResponse" }
          },
          "400": {
            "description": "Invalid payload format or missing name/price fields",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/inventory/{id}": {
      "put": {
        "tags": ["Inventory"],
        "summary": "Update inventory part details",
        "description": "Updates naming or pricing information for a specific stock part in inventory.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of part to update"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/InventoryPayload" }
          }
        ],
        "responses": {
          "200": {
            "description": "Part entry updated successfully",
            "schema": { "$ref": "#/definitions/InventoryResponse" }
          },
          "400": {
            "description": "Invalid parameter structure provided",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Inventory part ID not found",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      },
      "delete": {
        "tags": ["Inventory"],
        "summary": "Delete inventory part",
        "description": "Deletes a part record from the inventory system by unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of part to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Part entry deleted successfully",
            "schema": { "$ref": "#/definitions/MessageResponse" }
          },
          "404": {
            "description": "Target inventory part ID does not exist",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/service-tickets/": {
      "get": {
        "tags": ["Service Tickets"],
        "summary": "Get all service tickets",
        "description": "Fetches a full index of all logged mechanic shop service tickets, including linked customer info, assigned mechanics, and used parts.",
        "responses": {
          "200": {
            "description": "List of service tickets",
            "schema": {
              "type": "array",
              "items": { "$ref": "#/definitions/ServiceTicketResponse" }
            }
          }
        }
      },
      "post": {
        "tags": ["Service Tickets"],
        "summary": "Create service ticket",
        "description": "Generates a new service ticket for a vehicle VIN and links it to an existing registered customer account.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/ServiceTicketPayload" }
          }
        ],
        "responses": {
          "201": {
            "description": "Service ticket created",
            "schema": { "$ref": "#/definitions/ServiceTicketResponse" }
          },
          "400": {
            "description": "Invalid VIN string format, empty description, or bad customer ID",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Referenced customer ID does not exist",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/service-tickets/{ticket_id}/edit": {
      "put": {
        "tags": ["Service Tickets"],
        "summary": "Bulk edit mechanics on ticket",
        "description": "Allows simultaneous addition and removal of multiple mechanic assignments on a specified ticket by mechanic IDs.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Target service ticket ID"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/TicketMechanicsEditPayload" }
          }
        ],
        "responses": {
          "200": {
            "description": "Mechanic assignments updated on ticket",
            "schema": { "$ref": "#/definitions/ServiceTicketResponse" }
          },
          "400": {
            "description": "Malformed edit payload lists",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "404": {
            "description": "Target service ticket ID not found",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/service-tickets/{ticket_id}/add-part/{part_id}": {
      "put": {
        "tags": ["Service Tickets"],
        "summary": "Add part to service ticket",
        "description": "Attaches an inventory part item to a service ticket for billing and repair tracking purposes.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of service ticket"
          },
          {
            "name": "part_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of inventory part to add"
          }
        ],
        "responses": {
          "200": {
            "description": "Part successfully linked to ticket",
            "schema": { "$ref": "#/definitions/ServiceTicketResponse" }
          },
          "404": {
            "description": "Either the ticket ID or inventory part ID was not found",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    }
  },
  "definitions": {
    "CustomerPayload": {
      "type": "object",
      "required": ["name", "email", "phone", "password"],
      "properties": {
        "name": { "type": "string", "example": "Jane Doe" },
        "email": { "type": "string", "example": "jane@example.com" },
        "phone": { "type": "string", "example": "555-0199" },
        "password": { "type": "string", "example": "securepass123" }
      }
    },
    "CustomerUpdatePayload": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "Jane Smith" },
        "phone": { "type": "string", "example": "555-9999" }
      }
    },
    "CustomerResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "name": { "type": "string", "example": "Jane Doe" },
        "email": { "type": "string", "example": "jane@example.com" },
        "phone": { "type": "string", "example": "555-0199" }
      }
    },
    "CustomerPaginatedResponse": {
      "type": "object",
      "properties": {
        "customers": {
          "type": "array",
          "items": { "$ref": "#/definitions/CustomerResponse" }
        },
        "total": { "type": "integer", "example": 25 },
        "page": { "type": "integer", "example": 1 },
        "pages": { "type": "integer", "example": 3 }
      }
    },
    "LoginPayload": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": { "type": "string", "example": "jane@example.com" },
        "password": { "type": "string", "example": "securepass123" }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "message": { "type": "string", "example": "Login successful" }
      }
    },
    "MechanicPayload": {
      "type": "object",
      "required": ["name", "email", "phone", "salary"],
      "properties": {
        "name": { "type": "string", "example": "John Smith" },
        "email": { "type": "string", "example": "john@example.com" },
        "phone": { "type": "string", "example": "555-8888" },
        "salary": { "type": "number", "example": 65000.0 }
      }
    },
    "MechanicResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "name": { "type": "string", "example": "John Smith" },
        "email": { "type": "string", "example": "john@example.com" },
        "phone": { "type": "string", "example": "555-8888" },
        "salary": { "type": "number", "example": 65000.0 }
      }
    },
    "MostActiveMechanicResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "name": { "type": "string", "example": "John Smith" },
        "tickets_worked": { "type": "integer", "example": 5 }
      }
    },
    "InventoryPayload": {
      "type": "object",
      "required": ["name", "price"],
      "properties": {
        "name": { "type": "string", "example": "Brake Pad Set" },
        "price": { "type": "number", "example": 45.99 }
      }
    },
    "InventoryResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "name": { "type": "string", "example": "Brake Pad Set" },
        "price": { "type": "number", "example": 45.99 }
      }
    },
    "ServiceTicketPayload": {
      "type": "object",
      "required": ["vin", "service_desc", "customer_id"],
      "properties": {
        "vin": { "type": "string", "example": "1HGCR2F83HA000000" },
        "service_desc": {
          "type": "string",
          "example": "Brake replacement and oil change"
        },
        "customer_id": { "type": "integer", "example": 1 }
      }
    },
    "ServiceTicketResponse": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "vin": { "type": "string", "example": "1HGCR2F83HA000000" },
        "service_desc": {
          "type": "string",
          "example": "Brake replacement and oil change"
        },
        "customer_id": { "type": "integer", "example": 1 },
        "mechanics": {
          "type": "array",
          "items": { "$ref": "#/definitions/MechanicResponse" }
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/definitions/InventoryResponse" }
        }
      }
    },
    "TicketMechanicsEditPayload": {
      "type": "object",
      "properties": {
        "add_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "example": [1, 2]
        },
        "remove_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "example": [3]
        }
      }
    },
    "MessageResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Resource deleted successfully"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Invalid request parameter or unauthorized access"
        }
      }
    }
  }
}
